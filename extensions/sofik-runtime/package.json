{
  "name": "sofik-runtime",
  "displayName": "Sofik Runtime",
  "publisher": "sofik",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.138.0" },
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [
      { "command": "sofik.agent.prompt", "title": "Ask Agent", "category": "Sofik" },
      { "command": "sofik.agent.cancel", "title": "Cancel Agent", "category": "Sofik" },
      { "command": "sofik.agent.disconnect", "title": "Disconnect Agent", "category": "Sofik" },
      { "command": "sofik.languages.restart", "title": "Restart Language Servers", "category": "Sofik" }
    ],
    "keybindings": [{ "command": "sofik.agent.prompt", "key": "ctrl+alt+a", "mac": "cmd+alt+a" }]
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.18.0",
    "vscode-languageclient": "9.0.1"
  }
}
